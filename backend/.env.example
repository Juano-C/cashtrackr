# Copiar a .env.local para desarrollo local (ese archivo esta gitignored).
# En Render NO se usa este archivo: las variables se cargan en el dashboard.

# --- Opcion A: PostgreSQL local ya instalado (recomendado) ---
# Ejecutar `npm run db:setup` y el script crea este archivo por vos.
DATABASE_URL=postgresql://cashtrackr:cashtrackr@localhost:5432/cashtrackr
DB_SSL=false

# --- Opcion B: Render / Neon / Supabase (remoto) ---
# DATABASE_URL=postgresql://usuario:password@host:5432/base
# DB_SSL=true

# Fuerza SSL on/off. Si se omite, se detecta: local e interno de Render = off,
# cualquier host publico = on. Valores: true | false
# DB_SSL=true

# Muestra las consultas SQL en consola. Valores: true | false
# DB_LOGGING=false

# --- Autenticacion ---
JWT_SECRET=reemplazar-por-un-secreto-largo
# Duracion del JWT: 30 dias (definida en src/utils/jwt.ts)

# --- Email (nodemailer) ---
EMAIL_HOST=smtp.ejemplo.com
EMAIL_PORT=587
EMAIL_USER=usuario@ejemplo.com
EMAIL_PASS=password-del-smtp

# Puerto HTTP. En Render se inyecta automaticamente.
# PORT=4000
